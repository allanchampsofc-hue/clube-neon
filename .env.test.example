# Testes de integração/segurança usam o MESMO projeto Supabase de
# desenvolvimento por enquanto (sem banco de teste dedicado ainda) — copie os
# mesmos valores do seu .env.local. Os testes criam e limpam seus próprios
# dados (usuários/clientes com e-mail prefixado "test-"), não tocam no resto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
